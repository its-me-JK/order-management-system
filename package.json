{
  "name": "order-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Production-oriented distributed order management system",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "build": "pnpm db:generate && pnpm --recursive --if-present run build",
    "build:api": "pnpm --filter @oms/api... --if-present run build",
    "check": "pnpm format:check && pnpm db:schema:validate && pnpm db:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm --recursive --if-present run build",
    "db:generate": "pnpm --filter @oms/database run prisma:generate",
    "db:migrate:create": "pnpm --filter @oms/database run prisma:migrate:create",
    "db:migrate:deploy": "pnpm --filter @oms/database run prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @oms/database run prisma:migrate:dev",
    "db:migrate:status": "pnpm --filter @oms/database run prisma:migrate:status",
    "db:schema:validate": "pnpm --filter @oms/database run prisma:validate",
    "dev:api": "pnpm test:prepare && pnpm --filter @oms/api run dev",
    "dev:web": "pnpm --filter @oms/web run dev",
    "dev:worker": "pnpm --filter @oms/configuration run build && pnpm --filter @oms/database run build && pnpm --filter @oms/messaging run build && pnpm --filter @oms/worker run build && pnpm --filter @oms/worker run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up --detach --wait --wait-timeout 120",
    "lint": "eslint . --max-warnings=0",
    "start:api": "pnpm --filter @oms/api run start",
    "start:worker": "pnpm --filter @oms/worker run start",
    "smoke:showcase": "node scripts/smoke-showcase.mjs",
    "test": "pnpm test:prepare && jest --runInBand && pnpm --filter @oms/web run test",
    "test:coverage": "pnpm test:prepare && jest --coverage --runInBand",
    "test:integration:api": "pnpm --filter @oms/api run test:integration",
    "test:integration:database": "pnpm --filter @oms/database run test:integration",
    "test:prepare": "pnpm --filter @oms/configuration run build && pnpm --filter @oms/database run build && pnpm --filter @oms/redis run build && pnpm --filter @oms/messaging run build",
    "test:watch": "pnpm test:prepare && jest --watch",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
