// Lifecycle, chronology, UUID-version, closed-code, event-compatibility,
// active-slot, and credential-lifetime constraints plus per-column collations
// are intentionally owned by the reviewed migration SQL because Prisma's schema
// language cannot express them.

/// Identity persistence record; this is not the Account domain aggregate.
model IdentityAccountRecord {
  id              Bytes                         @id @db.Binary(16)
  loginName       String?                       @map("login_name") @db.VarChar(64)
  status          String                        @db.VarChar(16)
  version         Int                           @default(1) @db.UnsignedInt
  createdAt       DateTime                      @map("created_at") @db.DateTime(6)
  updatedAt       DateTime                      @map("updated_at") @db.DateTime(6)
  suspendedAt     DateTime?                     @map("suspended_at") @db.DateTime(6)
  deactivatedAt   DateTime?                     @map("deactivated_at") @db.DateTime(6)
  roleAssignments IdentityAccountRoleRecord[]
  sessionFamilies IdentitySessionFamilyRecord[]

  @@unique([loginName], map: "uq_identity_accounts_login_name")
  @@map("identity_accounts")
}

/// Immutable application-owned permission registry record.
model IdentityPermissionRecord {
  code            String                         @id @db.VarChar(98)
  description     String                         @db.VarChar(160)
  roleAssignments IdentityRolePermissionRecord[]

  @@map("identity_permissions")
}

/// Identity persistence record; this is not the Role domain aggregate.
model IdentityRoleRecord {
  id                 Bytes                          @id @db.Binary(16)
  code               String                         @db.VarChar(64)
  displayName        String                         @map("display_name") @db.VarChar(100)
  status             String                         @db.VarChar(16)
  version            Int                            @default(1) @db.UnsignedInt
  createdAt          DateTime                       @map("created_at") @db.DateTime(6)
  updatedAt          DateTime                       @map("updated_at") @db.DateTime(6)
  retiredAt          DateTime?                      @map("retired_at") @db.DateTime(6)
  permissionMappings IdentityRolePermissionRecord[]
  accountAssignments IdentityAccountRoleRecord[]

  @@unique([code], map: "uq_identity_roles_code")
  @@map("identity_roles")
}

/// Explicit Role-to-Permission mapping owned by the Role aggregate transaction.
model IdentityRolePermissionRecord {
  roleId         Bytes                    @map("role_id") @db.Binary(16)
  permissionCode String                   @map("permission_code") @db.VarChar(98)
  role           IdentityRoleRecord       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_role_permissions_role")
  permission     IdentityPermissionRecord @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_role_permissions_permission")

  @@id([roleId, permissionCode])
  @@index([permissionCode, roleId], map: "ix_identity_role_permissions_permission_role")
  @@map("identity_role_permissions")
}

/// Explicit Account-to-Role assignment; it is not part of either aggregate.
model IdentityAccountRoleRecord {
  accountId Bytes                 @map("account_id") @db.Binary(16)
  roleId    Bytes                 @map("role_id") @db.Binary(16)
  account   IdentityAccountRecord @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_account_roles_account")
  role      IdentityRoleRecord    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_account_roles_role")

  @@id([accountId, roleId])
  @@index([roleId, accountId], map: "ix_identity_account_roles_role_account")
  @@map("identity_account_roles")
}

/// Identity persistence record; this is not the SessionFamily domain aggregate.
model IdentitySessionFamilyRecord {
  id                 Bytes                             @id @db.Binary(16)
  accountId          Bytes                             @map("account_id") @db.Binary(16)
  version            Int                               @default(1) @db.UnsignedInt
  createdAt          DateTime                          @map("created_at") @db.DateTime(6)
  lastRotatedAt      DateTime                          @map("last_rotated_at") @db.DateTime(6)
  idleExpiresAt      DateTime                          @map("idle_expires_at") @db.DateTime(6)
  absoluteExpiresAt  DateTime                          @map("absolute_expires_at") @db.DateTime(6)
  revokedAt          DateTime?                         @map("revoked_at") @db.DateTime(6)
  closedReason       String?                           @map("closed_reason") @db.VarChar(32)
  account            IdentityAccountRecord             @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_session_families_account")
  refreshCredentials IdentityRefreshCredentialRecord[]

  @@index([accountId, revokedAt, absoluteExpiresAt, id], map: "ix_identity_session_families_account_authentication")
  @@index([absoluteExpiresAt, id], map: "ix_identity_session_families_absolute_expiry")
  @@map("identity_session_families")
}

/// Identity persistence record; this is not the RefreshCredential domain entity.
model IdentityRefreshCredentialRecord {
  id                     Bytes                            @id @db.Binary(16)
  familyId               Bytes                            @map("family_id") @db.Binary(16)
  digest                 Bytes                            @db.Binary(32)
  sequence               Int                              @db.UnsignedInt
  issuedAt               DateTime                         @map("issued_at") @db.DateTime(6)
  expiresAt              DateTime                         @map("expires_at") @db.DateTime(6)
  consumedAt             DateTime?                        @map("consumed_at") @db.DateTime(6)
  successorId            Bytes?                           @map("successor_id") @db.Binary(16)
  activeSlot             Int?                             @map("active_slot") @db.UnsignedTinyInt
  family                 IdentitySessionFamilyRecord      @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_refresh_credentials_family")
  successor              IdentityRefreshCredentialRecord? @relation("IdentityRefreshCredentialSuccessor", fields: [successorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_refresh_credentials_successor")
  predecessor            IdentityRefreshCredentialRecord? @relation("IdentityRefreshCredentialSuccessor")
  issuedAccessCredential IdentityAccessCredentialRecord?  @relation("IdentityCredentialGeneration")

  @@unique([digest], map: "uq_identity_refresh_credentials_digest")
  @@unique([familyId, sequence], map: "uq_identity_refresh_credentials_family_sequence")
  @@unique([successorId], map: "uq_identity_refresh_credentials_successor")
  @@unique([familyId, activeSlot], map: "uq_identity_refresh_credentials_family_active_slot")
  @@index([expiresAt, id], map: "ix_identity_refresh_credentials_expiry")
  @@map("identity_refresh_credentials")
}

/// Identity persistence record; this is not the AccessCredential domain entity.
model IdentityAccessCredentialRecord {
  id                        Bytes                           @id @db.Binary(16)
  familyId                  Bytes                           @map("family_id") @db.Binary(16)
  digest                    Bytes                           @db.Binary(32)
  sequence                  Int                             @db.UnsignedInt
  issuedAt                  DateTime                        @map("issued_at") @db.DateTime(6)
  expiresAt                 DateTime                        @map("expires_at") @db.DateTime(6)
  issuanceRefreshCredential IdentityRefreshCredentialRecord @relation("IdentityCredentialGeneration", fields: [familyId, sequence], references: [familyId, sequence], onDelete: Restrict, onUpdate: Restrict, map: "fk_identity_access_credentials_refresh_generation")

  @@unique([digest], map: "uq_identity_access_credentials_digest")
  @@unique([familyId, sequence], map: "uq_identity_access_credentials_family_sequence")
  @@index([familyId, expiresAt, id], map: "ix_identity_access_credentials_family_expiry")
  @@index([expiresAt, id], map: "ix_identity_access_credentials_expiry")
  @@map("identity_access_credentials")
}

/// Logically append-only security evidence. Identifier columns deliberately
/// have no relations so retention workflows cannot erase historical evidence.
model IdentitySecurityEventRecord {
  id                Bytes    @id @db.Binary(16)
  eventType         String   @map("event_type") @db.VarChar(48)
  outcome           String   @db.VarChar(16)
  reasonCode        String?  @map("reason_code") @db.VarChar(32)
  actorAccountId    Bytes?   @map("actor_account_id") @db.Binary(16)
  subjectAccountId  Bytes?   @map("subject_account_id") @db.Binary(16)
  roleId            Bytes?   @map("role_id") @db.Binary(16)
  sessionId         Bytes?   @map("session_id") @db.Binary(16)
  permissionCode    String?  @map("permission_code") @db.VarChar(98)
  requestId         Bytes?   @map("request_id") @db.Binary(16)
  correlationId     Bytes?   @map("correlation_id") @db.Binary(16)
  operatorReference String?  @map("operator_reference") @db.VarChar(128)
  occurredAt        DateTime @map("occurred_at") @db.DateTime(6)

  @@index([occurredAt, id], map: "ix_identity_security_events_time")
  @@index([subjectAccountId, occurredAt, id], map: "ix_identity_security_events_subject_time")
  @@index([sessionId, occurredAt, id], map: "ix_identity_security_events_session_time")
  @@map("identity_security_events")
}
