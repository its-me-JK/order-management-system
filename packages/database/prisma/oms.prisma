enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  COMMIT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model UserRecord {
  id           String               @id @db.Char(36)
  email        String               @unique(map: "uq_users_email") @db.VarChar(191)
  displayName  String               @map("display_name") @db.VarChar(120)
  passwordHash String               @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus           @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  sessions     SessionRecord[]
  orders       OrderRecord[]
  notifications NotificationRecord[]

  @@map("users")
}

model SessionRecord {
  id               String     @id @db.Char(36)
  userId           String     @map("user_id") @db.Char(36)
  accessTokenHash  String     @unique(map: "uq_sessions_access_token_hash") @map("access_token_hash") @db.Char(64)
  refreshTokenHash String     @unique(map: "uq_sessions_refresh_token_hash") @map("refresh_token_hash") @db.Char(64)
  csrfTokenHash    String     @map("csrf_token_hash") @db.Char(64)
  accessExpiresAt  DateTime   @map("access_expires_at") @db.DateTime(3)
  refreshExpiresAt DateTime   @map("refresh_expires_at") @db.DateTime(3)
  revokedAt        DateTime?  @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  user             UserRecord @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sessions_user")

  @@index([userId, revokedAt, refreshExpiresAt], map: "ix_sessions_user_active")
  @@index([refreshExpiresAt], map: "ix_sessions_refresh_expiry")
  @@map("sessions")
}

model ProductRecord {
  id          String        @id @db.Char(36)
  name        String        @db.VarChar(160)
  description String        @db.VarChar(1000)
  status      ProductStatus @default(DRAFT)
  version     Int           @default(1) @db.UnsignedInt
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  skus        SkuRecord[]

  @@index([status, createdAt, id], map: "ix_products_public")
  @@map("products")
}

model SkuRecord {
  id          String                 @id @db.Char(36)
  productId   String                 @map("product_id") @db.Char(36)
  code        String                 @unique(map: "uq_skus_code") @db.VarChar(64)
  name        String                 @db.VarChar(160)
  price       Decimal                @db.Decimal(12, 2)
  currency    String                 @default("INR") @db.Char(3)
  status      ProductStatus          @default(DRAFT)
  version     Int                    @default(1) @db.UnsignedInt
  createdAt   DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  product     ProductRecord          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_skus_product")
  inventory   InventoryItemRecord[]
  orderItems  OrderItemRecord[]
  reservationLines InventoryReservationLineRecord[]
  movements   InventoryMovementRecord[]

  @@index([productId, status, createdAt, id], map: "ix_skus_product_status")
  @@index([status, createdAt, id], map: "ix_skus_public")
  @@map("skus")
}

model WarehouseRecord {
  id          String                       @id @db.Char(36)
  code        String                       @unique(map: "uq_warehouses_code") @db.VarChar(32)
  name        String                       @db.VarChar(120)
  createdAt   DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  inventory   InventoryItemRecord[]
  reservations InventoryReservationRecord[]
  movements   InventoryMovementRecord[]

  @@map("warehouses")
}

model InventoryItemRecord {
  id          String          @id @db.Char(36)
  warehouseId String          @map("warehouse_id") @db.Char(36)
  skuId       String          @map("sku_id") @db.Char(36)
  onHand      Int             @default(0) @map("on_hand") @db.UnsignedInt
  reserved    Int             @default(0) @db.UnsignedInt
  available   Int             @default(0) @db.UnsignedInt
  version     Int             @default(1) @db.UnsignedInt
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  warehouse   WarehouseRecord @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_warehouse")
  sku         SkuRecord       @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_sku")

  @@unique([warehouseId, skuId], map: "uq_inventory_warehouse_sku")
  @@index([skuId, available], map: "ix_inventory_sku_available")
  @@map("inventory_items")
}

model InventoryReservationRecord {
  id          String                     @id @db.Char(36)
  orderId     String                     @unique(map: "uq_inventory_reservations_order") @map("order_id") @db.Char(36)
  warehouseId String                     @map("warehouse_id") @db.Char(36)
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime                   @map("expires_at") @db.DateTime(3)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  order       OrderRecord                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reservations_order")
  warehouse   WarehouseRecord            @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reservations_warehouse")
  lines       InventoryReservationLineRecord[]

  @@index([status, expiresAt], map: "ix_reservations_expiry")
  @@map("inventory_reservations")
}

model InventoryReservationLineRecord {
  reservationId String                     @map("reservation_id") @db.Char(36)
  skuId         String                     @map("sku_id") @db.Char(36)
  quantity      Int                        @db.UnsignedInt
  reservation   InventoryReservationRecord @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_reservation_lines_reservation")
  sku           SkuRecord                  @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reservation_lines_sku")

  @@id([reservationId, skuId])
  @@map("inventory_reservation_lines")
}

model InventoryMovementRecord {
  id          String                @id @db.Char(36)
  warehouseId String                @map("warehouse_id") @db.Char(36)
  skuId       String                @map("sku_id") @db.Char(36)
  type        InventoryMovementType
  quantity    Int
  reference   String?               @db.VarChar(100)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  warehouse   WarehouseRecord       @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_movements_warehouse")
  sku         SkuRecord             @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_movements_sku")

  @@index([skuId, createdAt], map: "ix_movements_sku_time")
  @@map("inventory_movements")
}

model OrderRecord {
  id                  String                  @id @db.Char(36)
  orderNumber         String                  @unique(map: "uq_orders_number") @map("order_number") @db.VarChar(32)
  userId              String                  @map("user_id") @db.Char(36)
  idempotencyKey      String                  @map("idempotency_key") @db.VarChar(100)
  idempotencyFingerprint String               @map("idempotency_fingerprint") @db.Char(64)
  status              OrderStatus             @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatus           @default(PENDING) @map("payment_status")
  currency            String                  @default("INR") @db.Char(3)
  subtotal            Decimal                 @db.Decimal(12, 2)
  total               Decimal                 @db.Decimal(12, 2)
  customerName        String                  @map("customer_name") @db.VarChar(120)
  customerEmail       String                  @map("customer_email") @db.VarChar(191)
  shippingAddress     Json                    @map("shipping_address")
  version             Int                     @default(1) @db.UnsignedInt
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  user                UserRecord              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders_user")
  items               OrderItemRecord[]
  history             OrderStatusHistoryRecord[]
  reservation         InventoryReservationRecord?
  payment             PaymentRecord?
  notifications       NotificationRecord[]

  @@unique([userId, idempotencyKey], map: "uq_orders_user_idempotency")
  @@index([userId, createdAt, id], map: "ix_orders_user_time")
  @@index([status, createdAt, id], map: "ix_orders_status_time")
  @@map("orders")
}

model OrderItemRecord {
  id           String      @id @db.Char(36)
  orderId      String      @map("order_id") @db.Char(36)
  skuId        String      @map("sku_id") @db.Char(36)
  skuCode      String      @map("sku_code") @db.VarChar(64)
  skuName      String      @map("sku_name") @db.VarChar(160)
  quantity     Int         @db.UnsignedInt
  unitPrice    Decimal     @map("unit_price") @db.Decimal(12, 2)
  lineTotal    Decimal     @map("line_total") @db.Decimal(12, 2)
  order        OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_items_order")
  sku          SkuRecord   @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_items_sku")

  @@index([orderId], map: "ix_order_items_order")
  @@map("order_items")
}

model OrderStatusHistoryRecord {
  id        String      @id @db.Char(36)
  orderId   String      @map("order_id") @db.Char(36)
  fromStatus OrderStatus? @map("from_status")
  toStatus  OrderStatus @map("to_status")
  reason    String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  order     OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_history_order")

  @@index([orderId, createdAt], map: "ix_order_history_order_time")
  @@map("order_status_history")
}

model PaymentRecord {
  id                String        @id @db.Char(36)
  orderId           String        @unique(map: "uq_payments_order") @map("order_id") @db.Char(36)
  provider          String        @default("SIMULATED") @db.VarChar(32)
  providerReference String?       @unique(map: "uq_payments_provider_reference") @map("provider_reference") @db.VarChar(100)
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  failureReason     String?       @map("failure_reason") @db.VarChar(120)
  authorizedAt      DateTime?     @map("authorized_at") @db.DateTime(3)
  refundedAt        DateTime?     @map("refunded_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  order             OrderRecord   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payments_order")

  @@index([status, createdAt], map: "ix_payments_status_time")
  @@map("payments")
}

model NotificationRecord {
  id        String              @id @db.Char(36)
  eventId   String              @map("event_id") @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  orderId   String?             @map("order_id") @db.Char(36)
  channel   NotificationChannel @default(IN_APP)
  type      String              @db.VarChar(100)
  title     String              @db.VarChar(160)
  message   String              @db.VarChar(500)
  readAt    DateTime?           @map("read_at") @db.DateTime(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  user      UserRecord          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_notifications_user")
  order     OrderRecord?        @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_notifications_order")

  @@unique([eventId, userId, channel], map: "uq_notifications_event_user_channel")
  @@index([userId, readAt, createdAt], map: "ix_notifications_user_unread")
  @@map("notifications")
}

model OutboxEventRecord {
  id            String   @id @db.Char(36)
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id") @db.Char(36)
  eventType     String   @map("event_type") @db.VarChar(100)
  payload       Json
  attempts      Int      @default(0) @db.UnsignedInt
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.DateTime(3)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  lastError     String?  @map("last_error") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([publishedAt, nextAttemptAt, createdAt], map: "ix_outbox_pending")
  @@index([aggregateType, aggregateId, createdAt], map: "ix_outbox_aggregate")
  @@map("outbox_events")
}

model ProcessedMessageRecord {
  messageId   String   @map("message_id") @db.Char(36)
  consumer    String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  @@id([messageId, consumer])
  @@map("processed_messages")
}
