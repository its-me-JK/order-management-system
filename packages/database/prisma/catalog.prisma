// Lifecycle, format, timestamp-ordering constraints and per-column ASCII
// collations are intentionally owned by the reviewed migration SQL because
// Prisma's schema language cannot represent them.

/// Catalog persistence record; this is not the Product domain aggregate.
model CatalogProductRecord {
  id              Bytes              @id @db.Binary(16)
  name            String             @db.VarChar(160)
  status          String             @db.VarChar(16)
  version         Int                @default(1) @db.UnsignedInt
  createdAt       DateTime           @map("created_at") @db.DateTime(6)
  updatedAt       DateTime           @map("updated_at") @db.DateTime(6)
  statusChangedAt DateTime           @map("status_changed_at") @db.DateTime(6)
  activatedAt     DateTime?          @map("activated_at") @db.DateTime(6)
  archivedAt      DateTime?          @map("archived_at") @db.DateTime(6)
  skus            CatalogSkuRecord[]

  @@map("catalog_products")
}

/// Catalog persistence record; this is not the SKU domain aggregate.
model CatalogSkuRecord {
  id              Bytes                @id @db.Binary(16)
  productId       Bytes                @map("product_id") @db.Binary(16)
  code            String               @db.VarChar(64)
  name            String               @db.VarChar(160)
  status          String               @db.VarChar(16)
  version         Int                  @default(1) @db.UnsignedInt
  createdAt       DateTime             @map("created_at") @db.DateTime(6)
  updatedAt       DateTime             @map("updated_at") @db.DateTime(6)
  statusChangedAt DateTime             @map("status_changed_at") @db.DateTime(6)
  activatedAt     DateTime?            @map("activated_at") @db.DateTime(6)
  retiredAt       DateTime?            @map("retired_at") @db.DateTime(6)
  product         CatalogProductRecord @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_catalog_skus_product")

  @@unique([code], map: "uq_catalog_skus_code")
  @@index([status, createdAt, id], map: "ix_catalog_skus_public_traversal")
  @@index([productId, status, createdAt, id], map: "ix_catalog_skus_product_status_traversal")
  @@map("catalog_skus")
}
