{
  "name": "@oms/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test:integration": "pnpm --filter @oms/configuration run build && pnpm --filter @oms/database run build && tsc --project tsconfig.integration.json && node --test --test-concurrency=1 .integration-dist/test/health.integration-test.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/terminus": "11.1.1",
    "@oms/configuration": "workspace:*",
    "@oms/database": "workspace:*",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6"
  }
}
