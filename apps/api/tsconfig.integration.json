{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".integration-dist",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.integration-test.ts", "test-support/**/*.ts"],
  "exclude": [".integration-dist", "dist", "node_modules", "src/**/*.spec.ts"]
}
