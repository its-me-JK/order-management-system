# Local runtime settings. Copy this file to .env during first-time setup, then
# change DATABASE_PORT or REDIS_PORT if a default host port is already in use.
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=debug

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=oms
DATABASE_USER=oms_app
# The host process reads DATABASE_PASSWORD_FILE. Compose uses the separate
# source path below when mounting that same secret into a container.
DATABASE_PASSWORD_FILE=./.local/secrets/mysql-app-password
COMPOSE_MYSQL_APP_PASSWORD_FILE=./.local/secrets/mysql-app-password
MYSQL_ROOT_PASSWORD_FILE=./.local/secrets/mysql-root-password

# Bounded runtime connection defaults.
# Total connections available to one runtime. The database package reserves
# DATABASE_TRANSACTION_CONNECTION_LIMIT for exact-connection transactions and
# gives the remainder to Prisma (defaults: 2 direct + 3 Prisma).
DATABASE_CONNECTION_LIMIT=5
DATABASE_TRANSACTION_CONNECTION_LIMIT=2
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_PROBE_TIMEOUT_MS=1000
DATABASE_IDLE_TIMEOUT_SECONDS=300

# Local MySQL does not expose TLS. Showcase, staging, and production
# environments must set verify-identity. Add exactly one CA source only when
# the provider uses a private certificate authority.
DATABASE_TLS_MODE=disabled
# DATABASE_TLS_CA_FILE=/absolute/path/to/provider-ca.pem

# Shared deployment environments inject DATABASE_MIGRATION_URL as a secret.
# DATABASE_SHADOW_URL is required only while creating migrations locally or in
# a dedicated migration-development environment.

# Redis is an explicit fail-closed dependency for future credential issuance.
# Compose and the technical runtime use the same local secret file, but the
# runtime is not composed into the API yet. Keep this credential separate from
# the database credential. File credentials are canonical UTF-8, retain all
# bytes except one terminal LF/CRLF, and are limited to 8192 bytes after trim.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=oms_app
REDIS_PASSWORD_FILE=./.local/secrets/redis-app-password
COMPOSE_REDIS_PASSWORD_FILE=./.local/secrets/redis-app-password

# Bound connection, command, probe, shutdown, and in-process queue behavior.
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_PROBE_TIMEOUT_MS=500
REDIS_SHUTDOWN_TIMEOUT_MS=1000
REDIS_COMMAND_QUEUE_LIMIT=256

# Local Redis will not expose TLS. Showcase, staging, and production
# environments must use verify-identity and may supply one private
# certificate-authority source.
REDIS_TLS_MODE=disabled
# REDIS_TLS_CA_FILE=/absolute/path/to/provider-ca.pem

# Identity credential-abuse keying is not composed into the API yet. The file
# must contain the canonical lowercase 64-hex encoding of exactly 32 random
# bytes, optionally followed by one LF or CRLF. Generate a local value with:
#   umask 077 && openssl rand -hex 32 > .local/secrets/identity-abuse-hmac-secret
# Keep this secret separate from Redis and database credentials.
IDENTITY_CREDENTIAL_ABUSE_HMAC_SECRET_FILE=./.local/secrets/identity-abuse-hmac-secret
# Local and test runtimes can derive these two defaults. Deployed replicas must
# provide the same reviewed, stable values explicitly; changing either starts
# a new abuse-control key namespace.
IDENTITY_CREDENTIAL_ABUSE_DEPLOYMENT_SCOPE=local
IDENTITY_CREDENTIAL_ABUSE_EPOCH=v1

# Refresh-specific token-bucket defaults. Capacity is 1..10000, refill
# interval is 1000..180000000 microseconds, and their product may not exceed
# 3600000000 microseconds.
IDENTITY_REFRESH_ABUSE_DEPLOYMENT_CAPACITY=300
IDENTITY_REFRESH_ABUSE_DEPLOYMENT_REFILL_INTERVAL_US=200000
IDENTITY_REFRESH_ABUSE_NETWORK_CAPACITY=120
IDENTITY_REFRESH_ABUSE_NETWORK_REFILL_INTERVAL_US=2500000
IDENTITY_REFRESH_ABUSE_PRESENTED_CREDENTIAL_CAPACITY=3
IDENTITY_REFRESH_ABUSE_PRESENTED_CREDENTIAL_REFILL_INTERVAL_US=100000000
