# Non-secret local infrastructure settings. Copy this file to .env only when
# overriding a default, such as MYSQL_PORT when port 3306 is already in use.
MYSQL_DATABASE=oms
MYSQL_USER=oms_app
MYSQL_PORT=3306
MYSQL_APP_PASSWORD_FILE=./.local/secrets/mysql-app-password
MYSQL_ROOT_PASSWORD_FILE=./.local/secrets/mysql-root-password

# Bounded runtime pool defaults. Application composition roots will validate
# these values before the database is wired into a runtime.
DATABASE_HOST=127.0.0.1
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_SECONDS=300

# Shared deployment environments inject DATABASE_MIGRATION_URL as a secret.
# DATABASE_SHADOW_URL is required only while creating migrations locally or in
# a dedicated migration-development environment.
