# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3001
DEMO_SEED=true

# MySQL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=oms
DATABASE_USER=oms_app
DATABASE_PASSWORD_FILE=./.local/secrets/mysql-app-password
COMPOSE_MYSQL_APP_PASSWORD_FILE=./.local/secrets/mysql-app-password
MYSQL_ROOT_PASSWORD_FILE=./.local/secrets/mysql-root-password
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_PROBE_TIMEOUT_MS=1000
DATABASE_IDLE_TIMEOUT_SECONDS=300
DATABASE_TLS_MODE=disabled
# DATABASE_TLS_CA_FILE=/absolute/path/to/provider-ca.pem

# Redis (used for login throttling)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=oms_app
REDIS_PASSWORD_FILE=./.local/secrets/redis-app-password
COMPOSE_REDIS_PASSWORD_FILE=./.local/secrets/redis-app-password
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_TLS_MODE=disabled
# REDIS_TLS_CA_FILE=/absolute/path/to/provider-ca.pem

# RabbitMQ and transactional-outbox worker
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=oms_app
RABBITMQ_VHOST=oms
RABBITMQ_PASSWORD_FILE=./.local/secrets/rabbitmq-password
COMPOSE_RABBITMQ_PASSWORD_FILE=./.local/secrets/rabbitmq-password
# Deployed environments may provide one complete RABBITMQ_URL instead.
RABBITMQ_CONNECT_TIMEOUT_MS=5000
RABBITMQ_PREFETCH=10
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_INITIAL_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
OUTBOX_MAX_ATTEMPTS=10

# Deployed environments inject DATABASE_PASSWORD, REDIS_PASSWORD, and
# RABBITMQ_URL through their secret manager. They must also use verified TLS.
